{
  "info": {
    "name": "Invoice API",
    "description": "Postman collection for testing all use cases in the Invoice API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Customers",
      "item": [
        {
          "name": "Get All Customers",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/customers"
          }
        },
        {
          "name": "Get Customer by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/customers/:id",
            "description": "Replace :id with the customer ID."
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000//api/customers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"123456789\",\n  \"address\": \"123 Main St\",\n  \"taxId\": \"123456789\",\n  \"notes\": \"VIP customer\"\n}"
            }
          }
        },
        {
          "name": "Update Customer",
          "request": {
            "method": "PUT",
            "url": "http://localhost:5000//api/customers/:id",
            "description": "Replace :id with the customer ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\"\n}"
            }
          }
        },
        {
          "name": "Delete Customer",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:5000//api/customers/:id",
            "description": "Replace :id with the customer ID."
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/products"
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/products/:id",
            "description": "Replace :id with the product ID."
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000//api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Product A\",\n  \"description\": \"Description of Product A\",\n  \"price\": 100,\n  \"unit\": \"piece\",\n  \"isActive\": true\n}"
            }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "url": "http://localhost:5000//api/products/:id",
            "description": "Replace :id with the product ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Product A\",\n  \"price\": 120\n}"
            }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:5000//api/products/:id",
            "description": "Replace :id with the product ID."
          }
        }
      ]
    },
    {
      "name": "Invoices",
      "item": [
        {
          "name": "Get All Invoices",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/invoices"
          }
        },
        {
          "name": "Get Invoice by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/invoices/:id",
            "description": "Replace :id with the invoice ID."
          }
        },
        {
          "name": "Create Invoice",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000//api/invoices",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": \"customer_id\",\n  \"items\": [\n    {\n      \"description\": \"Service A\",\n      \"quantity\": 2,\n      \"unitPrice\": 50\n    }\n  ],\n  \"status\": \"draft\",\n  \"notes\": \"This is a test invoice.\"\n}"
            }
          }
        },
        {
          "name": "Update Invoice",
          "request": {
            "method": "PUT",
            "url": "http://localhost:5000//api/invoices/:id",
            "description": "Replace :id with the invoice ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"sent\",\n  \"notes\": \"Updated notes.\"\n}"
            }
          }
        },
        {
          "name": "Delete Invoice",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:5000//api/invoices/:id",
            "description": "Replace :id with the invoice ID."
          }
        }
      ]
    },
    {
      "name": "Templates",
      "item": [
        {
          "name": "Get All Templates",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/templates"
          }
        },
        {
          "name": "Get Default Template",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/templates/default"
          }
        },
        {
          "name": "Create Template",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000//api/templates",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Template A\",\n  \"htmlTemplate\": \"<html><body>Template Content</body></html>\",\n  \"cssStyle\": \"body { font-family: Arial; }\",\n  \"isDefault\": true\n}"
            }
          }
        },
        {
          "name": "Update Template",
          "request": {
            "method": "PUT",
            "url": "http://localhost:5000//api/templates/:id",
            "description": "Replace :id with the template ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Template A\",\n  \"isDefault\": false\n}"
            }
          }
        },
        {
          "name": "Delete Template",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:5000//api/templates/:id",
            "description": "Replace :id with the template ID."
          }
        }
      ]
    },
    {
      "name": "Stats",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/stats/dashboard"
          }
        },
        {
          "name": "Monthly Income",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/stats/monthly-income"
          }
        },
        {
          "name": "Top Customers",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/stats/top-customers?limit=5&timeFrame=year"
          }
        },
        {
          "name": "Unpaid Invoices",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/stats/unpaid-invoices"
          }
        },
        {
          "name": "Income by Month",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000//api/stats/income-by-month/:year",
            "description": "Replace :year with the desired year."
          }
        }
      ]
    },
    {
      "name": "Scan Image",
      "item": [
        {
          "name": "Scan Image",
          "request": {
            "method": "POST",
            "url": "http://localhost:5000//api/scan-image",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
